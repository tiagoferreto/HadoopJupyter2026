{
  "name": "Python with Jupyter and Docker",

  "image": "mcr.microsoft.com/devcontainers/python:3.14-trixie",

  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false,
      "dockerDashComposeVersion": "v2"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },

  "postCreateCommand": "pip install jupyterlab"
}
